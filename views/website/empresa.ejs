<style>

    .search-box {
        margin-top: -35px;
        position: relative;
        z-index: 2;
    }

    .company-card {
        transition: all 0.2s ease;
    }

    .company-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08) !important;
    }

    .company-logo {
        width: 58px;
        height: 58px;
        border-radius: 16px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 23px;
    }

    .logo-tech {
        background: #e9f7ef;
        color: #198754;
    }

    .logo-finance {
        background: #fff3cd;
        color: #d39e00;
    }

    .logo-marketing {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .logo-consulting {
        background: #fce8e6;
        color: #dc3545;
    }

    .logo-retail {
        background: #e7f8fb;
        color: #0dcaf0;
    }

    .logo-people {
        background: #eeeeee;
        color: #6c757d;
    }

    .company-info {
        border-top: 1px solid #eee;
        padding-top: 15px;
        margin-top: 15px;
    }

    .company-info div {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .company-info i {
        width: 20px;
        color: #198754;
    }

    .page-link {
        color: #198754;
    }

    .page-item.active .page-link {
        background-color: #198754;
        border-color: #198754;
    }

    .cta-company {
        background: #212529;
    }

</style>