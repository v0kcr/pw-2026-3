                </div>


                <div class="col-lg-3">

                    <label class="form-label fw-semibold">
                        Sector
                    </label>

                    <select class="form-select">

                        <option selected>Todos los sectores</option>
                        <option>Tecnología</option>
                        <option>Finanzas</option>
                        <option>Marketing</option>
                        <option>Consultoría</option>
