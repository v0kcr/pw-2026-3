
<!-- views/website/home.ejs -->

<% layout("layouts/website") %>


<!-- =========================================================
     HERO
========================================================= -->

<section class="hero-home bg-dark text-white position-relative overflow-hidden">

  <div class="container py-5">

    <div class="row align-items-center min-vh-75 py-5">

      <!-- Texto -->
      <div class="col-lg-7 py-5">

        <span class="badge rounded-pill bg-success bg-opacity-25
                     text-success px-3 py-2 mb-4">

          <i class="fa-solid fa-graduation-cap me-2"></i>
          Oportunidades para estudiantes

        </span>


        <h1 class="display-2 fw-bold lh-1 mb-4">

          Tu primera experiencia
          <span class="text-success">
            empieza aquí.
          </span>

        </h1>


        <p class="lead text-secondary mb-4 pe-lg-5">

          Encuentra prácticas pre-profesionales,
          descubre nuevas oportunidades y empieza a
          construir tu futuro profesional.

        </p>


        <div class="d-flex flex-wrap gap-3">

          <a
            href="/convocatorias"
            class="btn btn-success btn-lg px-4 rounded-3">

            <i class="fa-solid fa-magnifying-glass me-2"></i>
            Buscar prácticas

          </a>


          <a
            href="/como-funciona"
            class="btn btn-outline-light btn-lg px-4 rounded-3">

            Cómo funciona
            <i class="fa-solid fa-arrow-right ms-2"></i>

          </a>

        </div>


        <!-- Mini estadísticas -->
        <div class="d-flex flex-wrap gap-4 mt-5">

          <div>
            <h4 class="fw-bold mb-0">
              500+
            </h4>

            <small class="text-secondary">
              Oportunidades
            </small>
          </div>


          <div>
            <h4 class="fw-bold mb-0">
              100+
            </h4>

            <small class="text-secondary">
              Empresas
            </small>
          </div>


          <div>
            <h4 class="fw-bold mb-0">
              24/7
            </h4>

            <small class="text-secondary">
              Disponible
            </small>
          </div>

        </div>

      </div>


      <!-- Tarjeta visual -->
      <div class="col-lg-5 d-none d-lg-block">

        <div class="position-relative">

          <!-- Círculo decorativo -->
          <div
            class="position-absolute top-50 start-50
                   translate-middle bg-success rounded-circle opacity-25"
            style="width:380px;height:380px;">

          </div>


          <!-- Card -->
          <div
            class="card border-0 shadow-lg rounded-4
                   position-relative">

            <div class="card-body p-4">


              <div class="d-flex justify-content-between
                          align-items-center mb-4">

                <div>

                  <small class="text-muted">
                    OPORTUNIDAD DESTACADA
                  </small>

                  <h5 class="fw-bold mb-0 mt-1">
                    Practicante de Tecnología
                  </h5>

                </div>

                <span
                  class="bg-success bg-opacity-10
                         text-success rounded-circle
                         d-flex align-items-center
                         justify-content-center"
                  style="width:45px;height:45px;">

                  <i class="fa-solid fa-code"></i>

                </span>

              </div>


              <div class="d-flex align-items-center mb-3">

                <div
                  class="bg-light rounded-3
                         d-flex align-items-center
                         justify-content-center me-3"
                  style="width:50px;height:50px;">

                  <i class="fa-solid fa-building text-success"></i>

                </div>

                <div>

                  <strong class="d-block">
                    Empresa
                  </strong>

                  <small class="text-muted">
                    Lima, Perú
                  </small>

                </div>

              </div>


              <div class="d-flex flex-wrap gap-2 mb-4">

                <span class="badge bg-light text-dark">
                  Tecnología
                </span>

                <span class="badge bg-light text-dark">
                  Híbrido
                </span>

                <span class="badge bg-light text-dark">
                  Part-time
                </span>

              </div>


              <div
                class="d-flex justify-content-between
                       align-items-center">

                <small class="text-muted">
                  Publicado recientemente
                </small>

                <span class="text-success fw-semibold">
                  Ver convocatoria
                  <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

              </div>

            </div>

          </div>


          <!-- Floating card -->
          <div
            class="card border-0 shadow position-absolute
                   bottom-0 start-0 translate-middle-y
                   rounded-3">

            <div class="card-body py-3 px-4">

              <div class="d-flex align-items-center">

                <div
                  class="bg-success bg-opacity-10
                         text-success rounded-circle
                         d-flex align-items-center
                         justify-content-center me-2"
                  style="width:38px;height:38px;">

                  <i class="fa-solid fa-check"></i>

                </div>

                <div>

                  <strong class="d-block text-dark">
                    ¡Postulación enviada!
                  </strong>

                  <small class="text-muted">
                    Tu perfil está avanzando
                  </small>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     BUSCADOR
========================================================= -->

<section class="position-relative">

  <div class="container">

    <div
      class="card border-0 shadow-lg rounded-4
             search-card">

      <div class="card-body p-4 p-lg-5">

        <div class="row align-items-end g-3">


          <div class="col-lg-5">

            <label class="form-label fw-semibold">
              ¿Qué tipo de práctica buscas?
            </label>

            <div class="input-group input-group-lg">

              <span class="input-group-text bg-white border-end-0">
                <i class="fa-solid fa-magnifying-glass text-muted"></i>
              </span>

              <input
                type="text"
                name="search"
                class="form-control border-start-0"
                placeholder="Cargo, área o palabra clave">

            </div>

          </div>


          <div class="col-lg-3">

            <label class="form-label fw-semibold">
              Modalidad
            </label>

            <select class="form-select form-select-lg">

              <option>
                Todas
              </option>

              <option>
                Presencial
              </option>

              <option>
                Híbrida
              </option>

              <option>
                Remota
              </option>

            </select>

          </div>


          <div class="col-lg-2">

            <label class="form-label fw-semibold">
              Área
            </label>

            <select class="form-select form-select-lg">

              <option>
                Todas
              </option>

              <option>
                Tecnología
              </option>

              <option>
                Marketing
              </option>

              <option>
                Finanzas
              </option>

            </select>

          </div>


          <div class="col-lg-2">

            <a
              href="/convocatorias"
              class="btn btn-success btn-lg w-100">

              Buscar

            </a>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     CONVOCATORIAS DESTACADAS
========================================================= -->

<section class="py-5">

  <div class="container py-4">


    <div class="d-flex justify-content-between
                align-items-end mb-4">

      <div>

        <span class="text-success fw-bold">
          OPORTUNIDADES
        </span>

        <h2 class="fw-bold mt-2 mb-1">
          Convocatorias destacadas
        </h2>

        <p class="text-muted mb-0">
          Descubre algunas de las oportunidades disponibles.
        </p>

      </div>


      <a
        href="/convocatorias"
        class="btn btn-outline-dark d-none d-md-block">

        Ver todas
        <i class="fa-solid fa-arrow-right ms-2"></i>

      </a>

    </div>


    <div class="row g-4">


      <!-- Convocatoria 1 -->
      <div class="col-md-4">

        <div
          class="card border-0 shadow-sm
                 h-100 rounded-4">

          <div class="card-body p-4">


            <div class="d-flex justify-content-between mb-4">

              <div
                class="bg-success bg-opacity-10
                       text-success rounded-3
                       d-flex align-items-center
                       justify-content-center"
                style="width:50px;height:50px;">

                <i class="fa-solid fa-code fs-5"></i>

              </div>


              <span class="badge bg-success bg-opacity-10 text-success">
                Nueva
              </span>

            </div>


            <h5 class="fw-bold">
              Practicante de Desarrollo
            </h5>

            <p class="text-muted small mb-3">
              Empresa tecnológica
            </p>


            <div class="d-flex flex-wrap gap-2 mb-4">

              <span class="badge bg-light text-dark">
                Tecnología
              </span>

              <span class="badge bg-light text-dark">
                Híbrido
              </span>

            </div>


            <div class="d-flex justify-content-between
                        align-items-center">

              <small class="text-muted">
                Lima
              </small>

              <a
                href="/convocatorias"
                class="text-success fw-semibold
                       text-decoration-none">

                Ver más
                <i class="fa-solid fa-arrow-right ms-1"></i>

              </a>

            </div>

          </div>

        </div>

      </div>


      <!-- Convocatoria 2 -->
      <div class="col-md-4">

        <div
          class="card border-0 shadow-sm
                 h-100 rounded-4">

          <div class="card-body p-4">


            <div class="d-flex justify-content-between mb-4">

              <div
                class="bg-primary bg-opacity-10
                       text-primary rounded-3
                       d-flex align-items-center
                       justify-content-center"
                style="width:50px;height:50px;">

                <i class="fa-solid fa-chart-line fs-5"></i>

              </div>


              <span class="badge bg-light text-dark">
                Disponible
              </span>

            </div>


            <h5 class="fw-bold">
              Practicante de Marketing
            </h5>

            <p class="text-muted small mb-3">
              Empresa de servicios
            </p>


            <div class="d-flex flex-wrap gap-2 mb-4">

              <span class="badge bg-light text-dark">
                Marketing
              </span>

              <span class="badge bg-light text-dark">
                Presencial
              </span>

            </div>


            <div class="d-flex justify-content-between
                        align-items-center">

              <small class="text-muted">
                Lima
              </small>

              <a
                href="/convocatorias"
                class="text-success fw-semibold
                       text-decoration-none">

                Ver más
                <i class="fa-solid fa-arrow-right ms-1"></i>

              </a>

            </div>

          </div>

        </div>

      </div>


      <!-- Convocatoria 3 -->
      <div class="col-md-4">

        <div
          class="card border-0 shadow-sm
                 h-100 rounded-4">

          <div class="card-body p-4">


            <div class="d-flex justify-content-between mb-4">

              <div
                class="bg-warning bg-opacity-10
                       text-warning rounded-3
                       d-flex align-items-center
                       justify-content-center"
                style="width:50px;height:50px;">

                <i class="fa-solid fa-coins fs-5"></i>

              </div>


              <span class="badge bg-light text-dark">
                Disponible
              </span>

            </div>


            <h5 class="fw-bold">
              Practicante de Finanzas
            </h5>

            <p class="text-muted small mb-3">
              Empresa corporativa
            </p>


            <div class="d-flex flex-wrap gap-2 mb-4">

              <span class="badge bg-light text-dark">
                Finanzas
              </span>

              <span class="badge bg-light text-dark">
                Híbrido
              </span>

            </div>


            <div class="d-flex justify-content-between
                        align-items-center">

              <small class="text-muted">
                Lima
              </small>

              <a
                href="/convocatorias"
                class="text-success fw-semibold
                       text-decoration-none">

                Ver más
                <i class="fa-solid fa-arrow-right ms-1"></i>

              </a>

            </div>

          </div>

        </div>

      </div>


    </div>

  </div>

</section>



<!-- =========================================================
     ESTADÍSTICAS
========================================================= -->

<section class="bg-light py-5">

  <div class="container py-4">

    <div class="row text-center g-4">


      <div class="col-6 col-lg-3">

        <h2 class="display-5 fw-bold text-success">
          500+
        </h2>

        <p class="text-muted mb-0">
          Convocatorias
        </p>

      </div>


      <div class="col-6 col-lg-3">

        <h2 class="display-5 fw-bold text-success">
          100+
        </h2>

        <p class="text-muted mb-0">
          Empresas
        </p>

      </div>


      <div class="col-6 col-lg-3">

        <h2 class="display-5 fw-bold text-success">
          1,000+
        </h2>

        <p class="text-muted mb-0">
          Estudiantes
        </p>

      </div>


      <div class="col-6 col-lg-3">

        <h2 class="display-5 fw-bold text-success">
          24/7
        </h2>

        <p class="text-muted mb-0">
          Plataforma disponible
        </p>

      </div>


    </div>

  </div>

</section>



<!-- =========================================================
     CÓMO FUNCIONA
========================================================= -->

<section
  id="como-funciona"
  class="py-5">

  <div class="container py-5">


    <div class="text-center mb-5">

      <span class="text-success fw-bold">
        SIMPLE Y RÁPIDO
      </span>

      <h2 class="fw-bold mt-2">
        ¿Cómo funciona?
      </h2>

      <p class="text-muted">
        Encontrar una práctica puede ser más sencillo.
      </p>

    </div>


    <div class="row g-5">


      <!-- Paso 1 -->
      <div class="col-md-4 text-center">

        <div
          class="bg-success bg-opacity-10
                 text-success rounded-circle
                 d-inline-flex align-items-center
                 justify-content-center mb-4"
          style="width:80px;height:80px;">

          <i class="fa-solid fa-user-plus fs-3"></i>

        </div>


        <div class="mb-2 text-success fw-bold">
          PASO 01
        </div>

        <h5 class="fw-bold">
          Crea tu perfil
        </h5>

        <p class="text-muted">
          Regístrate y completa tu información
          académica y profesional.
        </p>

      </div>


      <!-- Paso 2 -->
      <div class="col-md-4 text-center">

        <div
          class="bg-success bg-opacity-10
                 text-success rounded-circle
                 d-inline-flex align-items-center
                 justify-content-center mb-4"
          style="width:80px;height:80px;">

          <i class="fa-solid fa-magnifying-glass fs-3"></i>

        </div>


        <div class="mb-2 text-success fw-bold">
          PASO 02
        </div>

        <h5 class="fw-bold">
          Encuentra una oportunidad
        </h5>

        <p class="text-muted">
          Explora y filtra las convocatorias
          según tus intereses.
        </p>

      </div>


      <!-- Paso 3 -->
      <div class="col-md-4 text-center">

        <div
          class="bg-success bg-opacity-10
                 text-success rounded-circle
                 d-inline-flex align-items-center
                 justify-content-center mb-4"
          style="width:80px;height:80px;">

          <i class="fa-solid fa-paper-plane fs-3"></i>

        </div>


        <div class="mb-2 text-success fw-bold">
          PASO 03
        </div>

        <h5 class="fw-bold">
          Postula
        </h5>

        <p class="text-muted">
          Postula a las oportunidades que
          mejor se adapten a tu perfil.
        </p>

      </div>


    </div>

  </div>

</section>



<!-- =========================================================
     CTA
========================================================= -->

<section class="pb-5">

  <div class="container">

    <div
      class="bg-dark text-white rounded-4
             p-5 overflow-hidden position-relative">

      <div class="row align-items-center position-relative">

        <div class="col-lg-8">

          <span class="text-success fw-bold">
            ¿LISTO PARA EMPEZAR?
          </span>

          <h2 class="display-6 fw-bold mt-2">
            Tu próxima oportunidad
            puede estar aquí.
          </h2>

          <p class="text-secondary lead mb-0">
            Explora las convocatorias disponibles
            y comienza a construir tu experiencia.
          </p>

        </div>


        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

          <a
            href="/register"
            class="btn btn-success btn-lg px-4">

            Crear mi cuenta
            <i class="fa-solid fa-arrow-right ms-2"></i>

          </a>

        </div>

      </div>

    </div>

  </div>

</section>
