<% layout("layouts/website") %>

<div class="bg-light">

    <!-- HERO -->
    <section class="hero-how py-5 text-white">
        <div class="container py-5">

            <div class="row justify-content-center text-center">

                <div class="col-lg-8">

                    <span class="badge bg-success mb-3 px-3 py-2">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        ¿Cómo funciona?
                    </span>

                    <h1 class="display-4 fw-bold mb-3">
                        Tu próxima oportunidad,
                        <span class="text-success">más cerca de lo que crees.</span>
                    </h1>

                    <p class="lead text-white-50 mb-0">
                        En PrácticaLima puedes encontrar oportunidades,
                        conocer empresas y postular de manera sencilla.
                    </p>

                </div>

            </div>

        </div>
    </section>


    <!-- PASOS -->
    <section class="container py-5">

        <div class="text-center mb-5">

            <span class="text-success fw-semibold">
                PASO A PASO
            </span>

            <h2 class="fw-bold mt-2">
                Empieza en solo 3 pasos
            </h2>

            <p class="text-muted">
                No necesitas complicarte. Encuentra una oportunidad
                y empieza a construir tu experiencia profesional.
            </p>

        </div>


        <div class="row g-4">


            <!-- PASO 1 -->
            <div class="col-md-4">

                <div class="step-card text-center h-100">

                    <div class="step-number">
                        01
                    </div>

                    <div class="step-icon mx-auto">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                    <h4 class="fw-bold mt-4">
                        Crea tu perfil
                    </h4>

                    <p class="text-muted">
                        Regístrate y completa tu información académica,
                        habilidades e intereses profesionales.
                    </p>

                </div>

            </div>


            <!-- PASO 2 -->
            <div class="col-md-4">

                <div class="step-card text-center h-100">

                    <div class="step-number">
                        02
                    </div>

                    <div class="step-icon mx-auto">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>

                    <h4 class="fw-bold mt-4">
                        Encuentra una oportunidad
                    </h4>

                    <p class="text-muted">
                        Explora las convocatorias disponibles y encuentra
                        las que mejor se adapten a tu perfil.
                    </p>

                </div>

            </div>


            <!-- PASO 3 -->
            <div class="col-md-4">

                <div class="step-card text-center h-100">

                    <div class="step-number">
                        03
                    </div>

                    <div class="step-icon mx-auto">
                        <i class="fa-solid fa-paper-plane"></i>
                    </div>

                    <h4 class="fw-bold mt-4">
                        Postula
                    </h4>

                    <p class="text-muted">
                        Revisa los requisitos, envía tu postulación
                        y da el siguiente paso en tu carrera.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CONECTAMOS ESTUDIANTES Y EMPRESAS -->
    <section class="py-5 bg-white">

        <div class="container py-4">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <span class="text-success fw-semibold">
                        UNA PLATAFORMA PARA CONECTAR
                    </span>

                    <h2 class="fw-bold mt-2 mb-3">
                        Estudiantes y empresas
                        en un solo lugar.
                    </h2>

                    <p class="text-muted">
                        PrácticaLima busca facilitar el encuentro entre
                        estudiantes que quieren iniciar su experiencia
                        profesional y empresas que buscan nuevo talento.
                    </p>


                    <div class="d-flex gap-3 mb-4">

                        <div class="feature-icon">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Para estudiantes
                            </h5>

                            <p class="text-muted mb-0">
                                Descubre oportunidades que se ajusten
                                a tu carrera e intereses.
                            </p>
                        </div>

                    </div>


                    <div class="d-flex gap-3">

                        <div class="feature-icon">
                            <i class="fa-solid fa-building"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Para empresas
                            </h5>

                            <p class="text-muted mb-0">
                                Encuentra estudiantes con ganas de
                                aprender y desarrollarse.
                            </p>
                        </div>

                    </div>

                </div>


                <!-- VISUAL -->
                <div class="col-lg-6">

                    <div class="connection-card">

                        <div class="connection-item">

                            <div class="connection-icon student">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>

                            <div>
                                <strong>Estudiante</strong>
                                <small>
                                    Busca oportunidades
                                </small>
                            </div>

                        </div>


                        <div class="connection-line">

                            <span>
                                <i class="fa-solid fa-link"></i>
                            </span>

                        </div>


                        <div class="connection-item">

                            <div class="connection-icon platform">
                                <i class="fa-solid fa-handshake"></i>
                            </div>

                            <div>
                                <strong>PrácticaLima</strong>
                                <small>
                                    Conecta talento
                                </small>
                            </div>

                        </div>


                        <div class="connection-line">

                            <span>
                                <i class="fa-solid fa-link"></i>
                            </span>

                        </div>


                        <div class="connection-item">

                            <div class="connection-icon company">
                                <i class="fa-solid fa-building"></i>
                            </div>

                            <div>
                                <strong>Empresa</strong>
                                <small>
                                    Busca talento
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ¿QUÉ PUEDES HACER? -->
    <section class="container py-5">

        <div class="text-center mb-5">

            <span class="text-success fw-semibold">
                TODO EN UN SOLO LUGAR
            </span>

            <h2 class="fw-bold mt-2">
                ¿Qué puedes hacer en PrácticaLima?
            </h2>

        </div>


        <div class="row g-4">


            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-card-icon">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>

                    <h5 class="fw-bold">
                        Buscar prácticas
                    </h5>

                    <p class="text-muted small mb-0">
                        Explora oportunidades según tu carrera,
                        área o modalidad.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-card-icon">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <h5 class="fw-bold">
                        Conocer empresas
                    </h5>

                    <p class="text-muted small mb-0">
                        Descubre empresas y conoce las oportunidades
                        que tienen disponibles.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-card-icon">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>

                    <h5 class="fw-bold">
                        Revisar requisitos
                    </h5>

                    <p class="text-muted small mb-0">
                        Conoce los requisitos antes de decidir
                        dónde quieres postular.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-card-icon">
                        <i class="fa-solid fa-paper-plane"></i>
                    </div>

                    <h5 class="fw-bold">
                        Postular
                    </h5>

                    <p class="text-muted small mb-0">
                        Da el siguiente paso y presenta tu candidatura
                        a las oportunidades que te interesen.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- FAQ -->
    <section class="py-5 bg-white">

        <div class="container py-4">

            <div class="text-center mb-5">

                <span class="text-success fw-semibold">
                    PREGUNTAS FRECUENTES
                </span>

                <h2 class="fw-bold mt-2">
                    ¿Tienes alguna duda?
                </h2>

            </div>


            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <div class="accordion" id="faqAccordion">


                        <!-- FAQ 1 -->
                        <div class="accordion-item border-0 border-bottom">

                            <h2 class="accordion-header">

                                <button
                                    class="accordion-button fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq1"
                                >
                                    ¿Quiénes pueden utilizar PrácticaLima?
                                </button>

                            </h2>

                            <div
                                id="faq1"
                                class="accordion-collapse collapse show"
                                data-bs-parent="#faqAccordion"
                            >

                                <div class="accordion-body text-muted">
                                    La plataforma está pensada principalmente
                                    para estudiantes que buscan oportunidades
                                    de prácticas preprofesionales.
                                </div>

                            </div>

                        </div>


                        <!-- FAQ 2 -->
                        <div class="accordion-item border-0 border-bottom">

                            <h2 class="accordion-header">

                                <button
                                    class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq2"
                                >
                                    ¿Necesito tener experiencia?
                                </button>

                            </h2>

                            <div
                                id="faq2"
                                class="accordion-collapse collapse"
                                data-bs-parent="#faqAccordion"
                            >

                                <div class="accordion-body text-muted">
                                    No necesariamente. Existen oportunidades
                                    dirigidas a estudiantes que buscan
                                    comenzar a desarrollar su experiencia
                                    profesional.
                                </div>

                            </div>

                        </div>


                        <!-- FAQ 3 -->
                        <div class="accordion-item border-0 border-bottom">

                            <h2 class="accordion-header">

                                <button
                                    class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq3"
                                >
                                    ¿Puedo buscar por modalidad?
                                </button>

                            </h2>

                            <div
                                id="faq3"
                                class="accordion-collapse collapse"
                                data-bs-parent="#faqAccordion"
                            >

                                <div class="accordion-body text-muted">
                                    Sí. Las convocatorias pueden mostrar
                                    modalidades como presencial, híbrida
                                    o remota.
                                </div>

                            </div>

                        </div>


                        <!-- FAQ 4 -->
                        <div class="accordion-item border-0">

                            <h2 class="accordion-header">

                                <button
                                    class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq4"
                                >
                                    ¿Cómo encuentro una convocatoria?
                                </button>

                            </h2>

                            <div
                                id="faq4"
                                class="accordion-collapse collapse"
                                data-bs-parent="#faqAccordion"
                            >

                                <div class="accordion-body text-muted">
                                    Puedes ingresar a la sección de
                                    convocatorias y explorar las oportunidades
                                    disponibles según tus intereses.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="container py-5">

        <div class="cta-how rounded-4 p-5 text-white text-center">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <i class="fa-solid fa-rocket fs-1 mb-3"></i>

                    <h2 class="fw-bold mb-3">
                        ¿Listo para empezar?
                    </h2>

                    <p class="text-white-50 mb-4">
                        Explora las oportunidades disponibles y encuentra
                        una práctica que impulse tu carrera.
                    </p>

                    <a
                        href="/convocatorias"
                        class="btn btn-light btn-lg px-4"
                    >
                        Ver convocatorias
                        <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>

                </div>

            </div>

        </div>

    </section>

</div>


<style>

    /* HERO */

    .hero-how {
        background: #212529;
    }


    /* STEPS */

    .step-card {
        position: relative;
        background: white;
        border-radius: 20px;
        padding: 35px 25px;
        border: 1px solid #eeeeee;
        transition: all 0.2s ease;
    }

    .step-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .step-number {
        position: absolute;
        top: 18px;
        right: 20px;
        font-size: 13px;
        font-weight: bold;
        color: #198754;
    }

    .step-icon {
        width: 75px;
        height: 75px;
        border-radius: 22px;
        background: #e9f7ef;
        color: #198754;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 28px;
    }


    /* FEATURES */

    .feature-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;

        border-radius: 14px;
        background: #e9f7ef;
        color: #198754;

        display: flex;
        align-items: center;
        justify-content: center;
    }


    .feature-card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        height: 100%;

        border: 1px solid #eeeeee;

        transition: all 0.2s ease;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.07);
    }

    .feature-card-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;

        background: #e9f7ef;
        color: #198754;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 18px;

        font-size: 20px;
    }


    /* CONNECTION */

    .connection-card {
        background: #f8f9fa;
        border-radius: 25px;
        padding: 35px;
        border: 1px solid #eeeeee;
    }

    .connection-item {
        display: flex;
        align-items: center;
        gap: 15px;

        background: white;
        border-radius: 16px;
        padding: 18px;

        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .connection-item strong {
        display: block;
    }

    .connection-item small {
        color: #6c757d;
    }

    .connection-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;

        border-radius: 14px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 20px;
    }

    .connection-icon.student {
        background: #e9f7ef;
        color: #198754;
    }

    .connection-icon.platform {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .connection-icon.company {
        background: #fff3cd;
        color: #d39e00;
    }

    .connection-line {
        height: 45px;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .connection-line span {
        width: 32px;
        height: 32px;

        border-radius: 50%;

        background: #198754;
        color: white;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 12px;
    }


    /* CTA */

    .cta-how {
        background: #212529;
    }


    /* FAQ */

    .accordion-button {
        padding: 20px 0;
        background: white;
    }

    .accordion-button:not(.collapsed) {
        color: #198754;
        background: white;
        box-shadow: none;
    }

    .accordion-button:focus {
        box-shadow: none;
    }

</style>