<!-- views/partials/_footer.ejs -->

<footer class="bg-dark text-light pt-5 pb-4 mt-5">

  <div class="container">

    <div class="row g-4">

      <!-- Columna 1: Marca -->
      <div class="col-lg-4 col-md-6">

        <a
          href="/"
          class="text-decoration-none d-flex align-items-center mb-3">

          <i class="fa-solid fa-shield-halved text-success fs-3 me-2"></i>

          <h5 class="text-success fw-bold mb-0">
            PrácticaLima
          </h5>

        </a>

        <p class="text-secondary mb-3">
          Conectamos a estudiantes con oportunidades de
          prácticas pre-profesionales para impulsar su
          crecimiento profesional.
        </p>

        <!-- Redes sociales -->
        <div class="d-flex gap-3">

          <a
            href="#"
            class="text-secondary fs-5"
            aria-label="LinkedIn">

            <i class="fa-brands fa-linkedin"></i>

          </a>

          <a
            href="#"
            class="text-secondary fs-5"
            aria-label="Instagram">

            <i class="fa-brands fa-instagram"></i>

          </a>

        </div>

      </div>


      <!-- Columna 2: Plataforma -->
      <div class="col-lg-2 col-md-6">

        <h6 class="text-uppercase fw-bold mb-3">
          Plataforma
        </h6>

        <ul class="list-unstyled">

          <li class="mb-2">
            <a
              href="/"
              class="text-secondary text-decoration-none">

              Inicio

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/convocatorias"
              class="text-secondary text-decoration-none">

              Convocatorias

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/empresas"
              class="text-secondary text-decoration-none">

              Empresas

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/convocatorias/publicar"
              class="text-secondary text-decoration-none">

              Publicar convocatoria

            </a>
          </li>

        </ul>
      </div>

      <!-- Columna 3: Ayuda -->
      <div class="col-lg-2 col-md-6">
        <h6 class="text-uppercase fw-bold mb-3" style="color: #ffffff; letter-spacing: 1.5px; font-size: 0.8rem; opacity: 0.9;">Ayuda</h6>
        <ul class="list-unstyled small custom-footer-links">
          <li class="mb-2"><a href="/faq">Preguntas frecuentes</a></li>
          <li class="mb-2"><a href="/terminos">Términos del servicio</a></li>
          <li class="mb-2"><a href="/privacidad">Privacidad de datos</a></li>
        </ul>
      </div>


      <!-- Columna 3: Ayuda -->
      <div class="col-lg-2 col-md-6">

        <h6 class="text-uppercase fw-bold mb-3">
          Ayuda

        </h6>

        <ul class="list-unstyled">

          <li class="mb-2">
            <a
              href="/como-funciona"
              class="text-secondary text-decoration-none">

              Cómo funciona

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/preguntas-frecuentes"
              class="text-secondary text-decoration-none">

              Preguntas frecuentes

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/terminos"
              class="text-secondary text-decoration-none">

              Términos del servicio

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/privacidad"
              class="text-secondary text-decoration-none">

              Privacidad de datos

            </a>
          </li>
        </ul>
      </div>


      <!-- Columna 4: Contacto -->
      <div class="col-lg-4 col-md-6">

        <h6 class="text-uppercase fw-bold mb-3">
          Contáctanos
        </h6>

        <ul class="list-unstyled text-secondary">

          <li class="mb-3 d-flex">

            <i class="fa-solid fa-envelope text-success me-2 mt-1"></i>

            <a
              href="mailto:practicas@ulima.edu.pe"
              class="text-secondary text-decoration-none">

              practicas@ulima.edu.pe

            </a>

          </li>

          <li class="mb-3 d-flex">

            <i class="fa-solid fa-location-dot text-success me-2 mt-1"></i>

            <span>
              Av. Javier Prado Este 4600
              <br>
              Sede Monterrico, Lima
            </span>

          </li>

          <li class="d-flex">

            <i class="fa-solid fa-building-columns text-success me-2 mt-1"></i>

            <a
              href="https://www.ulima.edu.pe/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary text-decoration-none">

              Universidad de Lima

            </a>

          </li>

        </ul>

      </div>

    </div>


    <!-- Separador -->
    <hr class="border-secondary my-4">


    <!-- Parte inferior -->
    <div class="row align-items-center">

      <div class="col-md-6 text-center text-md-start">

        <p class="text-secondary small mb-0">
          © <%= new Date().getFullYear() %> PrácticaLima.
          Todos los derechos reservados.
        </p>

      </div>

      <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">

        <span class="text-secondary small">
          Una plataforma para impulsar tu futuro profesional.
        </span>

      </div>

    </div>

  </div>

  <!-- Estilos CSS extra para los efectos "cool" de animación -->
  <style>
    .custom-footer-links a {
      color: #8f94a6;
      text-decoration: none;
      display: inline-block;
      transition: all 0.3s ease;
    }
    .custom-footer-links a:hover {
      color: #ffffff;
      transform: translateX(4px);
      text-shadow: 0 0 8px rgba(255,255,255,0.3);
    }
    .custom-cool-btn {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(5px);
      transition: all 0.4s ease;
      box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .custom-cool-btn:hover {
      color: #0b0c10;
      background: #ffffff;
      border-color: #ffffff;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
      transform: translateY(-2px);
    }
  </style>
</footer>
